---
// Diskret ingång till aktuell utställning högst upp på startsidan.
// Döljs automatiskt när utställningen har stängt.
import '@fontsource/open-sans/300.css';
import { Image } from 'astro:assets';
import Status from './Status.astro';
import { status, lokal, type Utstallning } from '../../lib/utstallningar';
import { UTS_TEXT } from '../../lib/utstallning-text';
import type { Locale } from '../../lib/i18n';
import { u as url } from '../../lib/url';

interface Props {
  u: Utstallning;
  lang: Locale;
}
const { lang } = Astro.props;
const u = lokal(Astro.props.u, lang);
const t = UTS_TEXT[lang];
const visas = status(u) !== 'avslutad';
---

{
  visas && (
    <section class="teaser" data-dolj-nar-avslutad aria-label={`Utställning: ${u.titel}`}>
      <a href={url(`/${lang}/aktuellt/${u.slug}/`)}>
        <Status u={u} lang={lang} class="versal" />
        <span class="titel">{u.titel.toUpperCase()}</span>
        <span class="linje" aria-hidden="true" />
        <span class="plats">{u.galleri.namn}, {u.galleri.stad}</span>
        <span class="datum">{u.datumText}</span>
        <Image
          src={u.bild}
          alt={u.bildAlt}
          width={827}
          widths={[480, 827]}
          sizes="(max-width: 640px) 70vw, 400px"
          quality={88}
          loading="eager"
        />
        <span class="vidare">{t.tillUtstallningen} &rarr;</span>
      </a>
    </section>
  )
}

<style>
  .teaser {
    max-width: 760px;
    margin: 0 auto 140px;
    text-align: center;
  }
  .teaser[hidden] {
    display: none;
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .titel {
    margin-top: 16px;
    font-family: var(--font-tunn);
    font-weight: 300;
    font-size: clamp(40px, 8vw, 64px);
    line-height: 1;
    letter-spacing: 0.06em;
    padding-left: 0.06em;
    color: var(--ink);
  }
  .linje {
    width: min(70%, 340px);
    height: 1px;
    background: var(--ink);
    margin: 22px 0 16px;
  }
  .plats {
    font-size: 15px;
    letter-spacing: 0.04em;
  }
  .datum {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    color: var(--muted);
  }
  .teaser :global(img) {
    width: auto;
    max-height: 58vh;
    max-width: 400px;
    margin: 48px auto 0;
    border-radius: 0;
    mix-blend-mode: multiply;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  a:hover :global(img) {
    transform: translateY(-4px);
  }
  .vidare {
    margin-top: 28px;
    font-size: 14px;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  a:hover .vidare {
    color: var(--text);
    border-color: var(--muted);
  }
  @media (max-width: 640px) {
    .teaser {
      margin-bottom: 96px;
    }
    .teaser :global(img) {
      max-width: 70vw;
      max-height: 50vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .teaser :global(img) {
      transition: none;
    }
  }
</style>
